# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=InfraPulse AI
APP_ENV=development
APP_DEBUG=false
SECRET_KEY=change-me-to-a-very-long-random-secret-key-at-least-64-chars
ENCRYPTION_KEY=change-me-32-byte-fernet-key-base64=

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=infrapulse
POSTGRES_USER=infrapulse
POSTGRES_PASSWORD=infrapulse_secret
DATABASE_URL=postgresql+asyncpg://infrapulse:infrapulse_secret@postgres:5432/infrapulse
SYNC_DATABASE_URL=postgresql://infrapulse:infrapulse_secret@postgres:5432/infrapulse

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@redis:6379/0
CELERY_BROKER_URL=redis://:redis_secret@redis:6379/1
CELERY_RESULT_BACKEND=redis://:redis_secret@redis:6379/2

# ─── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret-key-very-long-and-random
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Platform Admin ───────────────────────────────────────────────────────────
PLATFORM_ADMIN_EMAIL=admin@infrapulse.local
PLATFORM_ADMIN_PASSWORD=ChangeMe123!
PLATFORM_ADMIN_NAME=Platform Administrator

# ─── SMTP Email ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_FROM_ADDRESS=noreply@infrapulse.local
SMTP_FROM_NAME=InfraPulse AI

# ─── Slack ────────────────────────────────────────────────────────────────────
# Configured per-organization from the dashboard

# ─── AI Providers ────────────────────────────────────────────────────────────
# Configured per-organization from the dashboard
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ─── Security ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000
RATE_LIMIT_PER_MINUTE=100
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# ─── Agent ────────────────────────────────────────────────────────────────────
AGENT_REGISTRATION_TOKEN_EXPIRE_HOURS=24
AGENT_HEARTBEAT_INTERVAL_SECONDS=60
AGENT_HEARTBEAT_TIMEOUT_SECONDS=300

# ─── Demo Mode ────────────────────────────────────────────────────────────────
SEED_DEMO_DATA=true
DEMO_MODE=true
